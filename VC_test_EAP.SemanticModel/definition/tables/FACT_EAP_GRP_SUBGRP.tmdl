			                CALCULATE ( [Member Months], ALL ( 'Standalone'[Standalone Code] ) ),
			                CALCULATE (
			                    [EAP MemberMonthsProdSubClsLevel],
			                    ALL ( 'Standalone'[Standalone Code] )
			                )
			            )
			        )
			    )
