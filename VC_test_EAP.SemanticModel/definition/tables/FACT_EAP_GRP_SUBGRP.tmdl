			        ALL ( 'Incurred Month' ),
			        DATESBETWEEN ( 'Incurred Month'[Incurred Month Begin Dt], min_date, max_date )
			    )
		formatString: #,0
		lineageTag: ce9dc34c-742c-4a5a-8f11-14ce028e3a16

