	measure IsEAPProductLevel? =
			IF (
			    ISFILTERED ( DIM_EAP_PROD_DESC[PROD_TYPE_DESC] )
			        || ISFILTERED ( DIM_EAP_PROD_DESC[PROD_CLS_DESC] )
			        || ISFILTERED ( DIM_EAP_PROD_DESC[RPT_PROD_NM] )
			        || ISFILTERED ( 'DIM_EAP_PROD_DESC'[Program Subclass Description] )
			        || ISFILTERED ( 'DIM_EAP_PROD_DESC'[Reporting Program Name] ),
			    FALSE (),
			    TRUE ()
			)
		lineageTag: 7bedbc36-e41d-4b1f-a44d-86979c5b9c93

