			        FACT_EAP_GRP_SUBGRP,
			        FACT_EAP_GRP_SUBGRP[ELGBL_MNTH_NBR],
			        FACT_EAP_GRP_SUBGRP[EAP_GRP_ID],
			        "max_cnt", MAX ( 'FACT_EAP_GRP_SUBGRP'[Group Estimated Member Count] )
			    )
			RETURN
