table FACT_EAP_GRP_SUBGRP
	lineageTag: 89641580-3bba-402c-8be1-c819f1160faa

	measure 'Employee Eligibility Base' =
			VAR a =
			    SUMMARIZE (
			        FACT_EAP_GRP_SUBGRP,
			        FACT_EAP_GRP_SUBGRP[ELGBL_MNTH_NBR],
			        FACT_EAP_GRP_SUBGRP[EAP_GRP_ID],
			        "max_cnt", MAX ( 'FACT_EAP_GRP_SUBGRP'[Group Employee Count] )
			    )
			RETURN
			    SUMX ( a, [max_cnt] )
		lineageTag: 9e2e8512-dd61-4cbc-8bf6-53ec23072ade

	measure 'Estimated Members Eligible Base' =
