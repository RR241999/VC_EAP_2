		lineageTag: 4a6388a1-0b27-4a8c-b762-c834604c7e10

	measure 'Employee Eligibility PY' =
			VAR __PP1 =
			    DATEADD ( 'Incurred Month'[Incurred Month Begin Dt], -1, YEAR )
			RETURN
			    CALCULATE ( [Employee Eligibility], ALL ( 'Incurred Month' ), __PP1 )
		lineageTag: 90431e03-a25b-4267-b4c5-054b30e58621

	measure 'Employee Eligibility %  Change' =
			VAR __Current = [Employee Eligibility]
			VAR __PastPeriod = [Employee Eligibility PY]
			RETURN
			    IF (
			        ISBLANK ( __Current ) && ISBLANK ( __PastPeriod ),
			        BLANK (),
			        IFERROR ( DIVIDE ( ( __Current - __PastPeriod ), __PastPeriod ), BLANK () )
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 85c4c83b-2878-4ff2-8ba8-33ba8506414a

	measure 'Estimated Members Eligible PY' =
			VAR __PP1 =
			    DATEADD ( 'Incurred Month'[Incurred Month Begin Dt], -1, YEAR )
			RETURN
			    CALCULATE ( [Estimated Members Eligible], ALL ( 'Incurred Month' ), __PP1 )
		lineageTag: 35daf281-4fc7-408e-b154-ab2e147a8835

	measure 'Estimated Members Eligible %  Change' =
			VAR __Current = [Estimated Members Eligible]
			VAR __PastPeriod = [Estimated Members Eligible PY]
			RETURN
			    IF (
			        ISBLANK ( __Current ) && ISBLANK ( __PastPeriod ),
			        BLANK (),
			        IFERROR ( DIVIDE ( ( __Current - __PastPeriod ), __PastPeriod ), BLANK () )
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 387183ff-9c60-4f01-9b02-411d4a507339

	measure 'Employee Eligibility' =
			
			VAR _Sliding =
			    TRIM ( [Selected Sliding Window] )
			VAR min_date =
			    IF (
			        _Sliding = "YTD",
			        STARTOFYEAR ( 'Incurred Month'[Incurred Month Begin Dt] ),
			        IF (
			            _Sliding = "15",
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( _Sliding )
			            ),
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( [Selected Sliding Window] )
			            )
			        )
			    )
			VAR max_date =
			    IF (
			        _Sliding = "15",
			        EDATE ( MAX ( 'Incurred Month'[Incurred Month Begin Dt] ), -3 ),
			        MAX ( 'Incurred Month'[Incurred Month Begin Dt] )
			    )
			RETURN
			    CALCULATE (
			        DIVIDE (
			            [Employee Eligibility Base],
			            DISTINCTCOUNT ( 'Incurred Month'[Incurred Month Begin Dt] )
			        ),
			        ALL ( 'Incurred Month' ),
			        DATESBETWEEN ( 'Incurred Month'[Incurred Month Begin Dt], min_date, max_date )
			    )
		formatString: #,0
		lineageTag: 6223c7ea-7fda-4de1-a56d-d586a8b62968

	measure 'Estimated Members Eligible' =
			
			VAR _Sliding =
