table FACT_EAP_MNGMNT_CNSLTTN_DTL
	lineageTag: 820298f8-0324-483e-8c1b-ad2a671761fc

	measure 'Management Consultations' =
			
			VAR _Sliding =
			    TRIM ( [Selected Sliding Window] )
			VAR min_date =
			    IF (
			        _Sliding = "YTD",
			        STARTOFYEAR ( 'Incurred Month'[Incurred Month Begin Dt] ),
			        IF (
			            _Sliding = "15",
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( _Sliding )
			            ),
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( [Selected Sliding Window] )
			            )
			        )
			    )
			VAR max_date =
			    IF (
			        _Sliding = "15",
			        EDATE ( MAX ( 'Incurred Month'[Incurred Month Begin Dt] ), -3 ),
			        MAX ( 'Incurred Month'[Incurred Month Begin Dt] ))
			RETURN
			    CALCULATE (
			        [Management Consultations Base],
			        ALL ( 'Incurred Month' ),
			        DATESBETWEEN ( 'Incurred Month'[Incurred Month Begin Dt], min_date, max_date )
			    )
		formatString: #,0
		lineageTag: 3ac6b884-2b38-465a-9c2d-0dee5ae5ca88

	measure 'Management Consultations PY' =
			VAR __PP1 =
			    DATEADD ( 'Incurred Month'[Incurred Month Begin Dt], -1, YEAR )
			RETURN
			    CALCULATE ( [Management Consultations], ALL ( 'Incurred Month' ), __PP1 )
		formatString: #,0
		lineageTag: aba0fe44-7ac9-4922-a945-64f46aa65a11

	measure 'Management Consultations %  Change' =
			
			VAR __Current = [Management Consultations]
			VAR __PastPeriod = [Management Consultations PY]
			RETURN
			    IF (
			        ISBLANK ( __Current ) && ISBLANK ( __PastPeriod ),
			        BLANK (),
			        IFERROR ( DIVIDE ( ( __Current - __PastPeriod ), __PastPeriod ), BLANK () )
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8744f9a1-26ca-434d-8493-0209dc20c5e2

	measure 'Management Consultations Base' = ```
			 Distinctcount('FACT_EAP_MNGMNT_CNSLTTN_DTL'[Management Consultation ID])
			```
		lineageTag: 0d8f9717-d985-4957-bab1-d4831391c956

