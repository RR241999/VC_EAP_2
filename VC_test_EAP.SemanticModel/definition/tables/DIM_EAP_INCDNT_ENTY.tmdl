	column TelehealthPreferenceCategory =
			IF (
			    OR (
			        DIM_EAP_INCDNT_ENTY[EAP Incident Service Code] = "EAP_NETWORK_COUNSELOR_LIVE_HEALTH_ONLINE",
			        DIM_EAP_INCDNT_ENTY[EAP Incident Service Code] = "EAP_NETWORK_COUNSELOR_TELEHEALTH"
			    ),
			    "Telehealth",
			    IF (
			        OR (
			            DIM_EAP_INCDNT_ENTY[EAP Incident Service Code] = "EAP_NETWORK_COUNSELOR_FACE_TO_FACE",
			            DIM_EAP_INCDNT_ENTY[EAP Incident Service Code] = "EAP_NETWORK_COUNSELOR_ONSITE"
			        ),
			        "Non-Telehealth"
			    )
			)
		dataType: string
		lineageTag: 47b47809-6f37-4a4e-8b4b-9ff45ccc9b94
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

