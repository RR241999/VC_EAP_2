table FACT_EAP_SPRVSR_RFRL_DTL
	lineageTag: a28fc5ac-5608-49d0-a7f5-7a294fc81057

	measure 'Management Referrals' =
			
			VAR _Sliding =
			    TRIM ( [Selected Sliding Window] )
			VAR min_date =
			    IF (
			        _Sliding = "YTD",
			        STARTOFYEAR ( 'Incurred Month'[Incurred Month Begin Dt] ),
			        IF (
			            _Sliding = "15",
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( _Sliding )
			            ),
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( [Selected Sliding Window] )
			            )
			        )
			    )
			VAR max_date =
			    IF (
			        _Sliding = "15",
			        EDATE ( MAX ( 'Incurred Month'[Incurred Month Begin Dt] ), -3 ),
			        MAX ( 'Incurred Month'[Incurred Month Begin Dt] ))
			RETURN
			    CALCULATE (
			        [Management Referrals Base],
			        ALL ( 'Incurred Month' ),
			        DATESBETWEEN ( 'Incurred Month'[Incurred Month Begin Dt], min_date, max_date )
			    )
		formatString: #,0
		lineageTag: 52f0a07e-b599-4d48-88fb-056c9411d7fc

	measure 'Management Referrals PY' =
			
			VAR __PP1 =
			    DATEADD ( 'Incurred Month'[Incurred Month Begin Dt], -1, YEAR )
			RETURN
			    CALCULATE ( [Management Referrals], ALL ( 'Incurred Month' ), __PP1 )
		formatString: #,0
		lineageTag: 7142128c-7dc8-4aa4-aa2b-ef66a0dd38ad

	measure 'Management Referrals %  Change_' = ```
			
			VAR __Current = [Management Referrals]
			VAR __PastPeriod = [Management Referrals PY]
			RETURN
			    IF (
			        ISBLANK ( __Current ) && ISBLANK ( __PastPeriod ),
			        BLANK (),
			        IFERROR ( DIVIDE ( ( __Current - __PastPeriod ), __PastPeriod ), BLANK () )
			    )
			    
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7bff1bf4-9e76-4a7f-ae95-f3c3a4599725

	measure 'Management Referrals Base' =
			
			Distinctcount('FACT_EAP_SPRVSR_RFRL_DTL'[Supervisor Referral ID])
		lineageTag: cd4a8225-c2e4-4fc3-bcf6-9f0a151434e5

