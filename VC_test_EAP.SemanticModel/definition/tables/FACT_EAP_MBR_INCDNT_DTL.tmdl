	measure 'Incidents with Max Sessions Completed Base' = ```
			VAR RemovedBlank =
			    FILTER (
			        'FACT_INCDNT_SESN',
			        NOT ( ISBLANK ( 'FACT_INCDNT_SESN'[Session Model Short Code] ) )
			    )
			VAR GroupedAndSummed =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            RemovedBlank,
			            'FACT_INCDNT_SESN'[Incident Number],
			            'FACT_INCDNT_SESN'[Session Model Short Code],
			            "TotalSessionCount",DISTINCTCOUNT ( 'FACT_INCDNT_SESN'[Total Session Count] )
			        ),
			        "MaxTotalSessionCount",
			            VAR CurrentINCDNT_NBR = 'FACT_INCDNT_SESN'[Incident Number]
			            VAR CurrentSESN_MDL_SHRT_CD = 'FACT_INCDNT_SESN'[Session Model Short Code]
			            RETURN
			                CALCULATE (
			                    MAXX (
			                        FILTER (
			                            RemovedBlank,
			                            'FACT_INCDNT_SESN'[Incident Number] = CurrentINCDNT_NBR
			                                && 'FACT_INCDNT_SESN'[Session Model Short Code] = CurrentSESN_MDL_SHRT_CD
			                        ),
			                        DISTINCTCOUNT ( 'FACT_INCDNT_SESN'[Total Session Count] )
			                    )
			                )
			    )
			VAR FilteredMaxCounts =
			    FILTER (
			        GroupedAndSummed,
			        [MaxTotalSessionCount]
			            >= VALUE ( [Session Model Short Code] ) 
			    )
			RETURN
			    COUNTROWS ( SUMMARIZE ( FilteredMaxCounts, 'FACT_INCDNT_SESN'[Incident Number] ) )
			```
		lineageTag: a9f1d966-7e20-427c-a9f3-b9a19b4f9346

