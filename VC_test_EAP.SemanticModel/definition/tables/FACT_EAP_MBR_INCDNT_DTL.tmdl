	measure 'Incident Creation Rate Employees Base' =
			
			VAR _DEM = [Employee Eligibility Base]
			VAR _NUM =
			    CALCULATE (
			        DISTINCTCOUNT ( 'FACT_EAP_MBR_INCDNT_DTL'[Member Reference Number] ),
			        DIM_EAP_CALR_TYPE[EAP Incident Caller Type Description] = "EMPLOYEE"
			    )
			RETURN
			    DIVIDE ( _NUM, _DEM )
		lineageTag: 0133ecd5-a239-43fe-a14c-2e3869947a71

	measure 'Incident Creation Rate EAP Members with household Base' =
			
			VAR _NUM = [Total Members with Incident Base]
			VAR _DEM =  [Employee Eligibility Base]
			RETURN
			DIVIDE(_NUM,_DEM)
		lineageTag: 882a7540-d37b-4c65-bbbc-7aa23c387849

	measure 'Incident Creation Rate Anthem Members PY' =
			VAR __PP1 =
			    DATEADD ( 'Incurred Month'[Incurred Month Begin Dt], -1, YEAR )
			RETURN
			    CALCULATE ( [Incident Creation Rate Anthem Members], ALL ( 'Incurred Month' ), __PP1 )
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 8460712e-c69c-482a-9ecc-cf26add13a62

	measure 'Incident Creation Rate Anthem Members %  Change' =
			
			VAR __Current = [Incident Creation Rate Anthem Members]
			VAR __PastPeriod = [Incident Creation Rate Anthem Members PY]
			RETURN
			    IF (
			        ISBLANK ( __Current ) && ISBLANK ( __PastPeriod ),
			        BLANK (),
			        IFERROR ( DIVIDE ( ( __Current - __PastPeriod ), __PastPeriod ), BLANK () )
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7fc1b051-6e98-41af-8047-b56d404c4a3c

