table FACT_EAP_WBS_PROD_OUTRCH
	lineageTag: a3cfa56c-780f-4f1a-ae75-448343598e5f

	measure 'EAP MemberMonthsBase' =
			CALCULATE (
			    SUM ( 'FACT_EAP_WBS_PROD_OUTRCH'[PRORTD_MBR_MNTH_CNT] )
			  /*  ,
			    FILTER (
			        KEEPFILTERS ( VALUES ( 'DIM_EAP_PROD'[EAP Product Description] ) ),
			        NOT ( 'DIM_EAP_PROD'[EAP Product Description] IN { BLANK () } )
			    )*/
			)
		lineageTag: 5fc03ebe-3d56-42b9-9caf-6541e982bd4b

	measure 'Member Months' =
			VAR _Sliding =
			    TRIM ( [Selected Sliding Window] )
			VAR min_date =
			    IF (
			        _Sliding = "YTD",
			        STARTOFYEAR ( 'Incurred Month'[Incurred Month Begin Dt] ),
			        IF (
			            _Sliding = "15",
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( _Sliding )
			            ),
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( [Selected Sliding Window] )
			            )
			        )
			    )
			VAR max_date =
			    IF (
			        _Sliding = "15",
			        EDATE ( MAX ( 'Incurred Month'[Incurred Month Begin Dt] ), -3 ),
			        MAX ( 'Incurred Month'[Incurred Month Begin Dt] )
			    )
			RETURN
			    CALCULATE (
			        [EAP MemberMonthsBase],
			        ALL ( 'Incurred Month' ),
			        DATESBETWEEN ( 'Incurred Month'[Incurred Month Begin Dt], min_date, max_date )
			    )
		lineageTag: 9a3b2560-1ca3-4ddf-be2b-4c8cf15c7ead

