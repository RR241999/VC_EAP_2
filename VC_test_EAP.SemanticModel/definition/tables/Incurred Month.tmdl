	column 'Incurred Month Year Dashboard' = 'Incurred Month'[Incurred Month of Year Short Nm] & "'" & RIGHT('Incurred Month'[Incurred Year],2)
		lineageTag: 5fd7a57a-c660-4649-ac5d-1c8d268c9c96
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Month Difference' =
			
			VAR mxm =
			    MAX ( [Incurred Month Begin Dt] )
			RETURN
			    DATEDIFF ( [Incurred Month Begin Dt], mxm, MONTH )
		lineageTag: 1daba63e-9ba4-4893-8641-ce267d90db11
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column LatestIncurredMonthInd =
			IF (
			    'Incurred Month'[Incurred Year Month Nbr] = 'Incurred Month'[Latest Incurred Month],
			    "Current",
			    IF (
			        'Incurred Month'[Incurred Year Month Nbr] > 'Incurred Month'[Latest Incurred Month],
			        " Current + 1 Month (Advanced)",
			        "Previous"
			    )
			)
		lineageTag: 04fcd286-d2a5-4112-897e-43f147ec3d45
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Latest Incurred Month' =
			CALCULATE (
			    MAX ( 'Incurred Month'[Incurred Year Month Nbr] ),
			    FILTER (
			        'Incurred Month',
			        'Incurred Month'[Incurred Year Month Nbr]
			            <> MAX ( 'Incurred Month'[Incurred Year Month Nbr] )
			    )
			)
		lineageTag: 53d555eb-5208-47a7-aaf2-9918f2c691e4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	hierarchy Latest_Incurred_Month
		lineageTag: 272e6955-62a1-4f85-9b55-2a8d43f9f8da

		level LatestIncurredMonthInd
			lineageTag: 40bcbf58-c232-4443-9d4e-c939cfb906df
			column: LatestIncurredMonthInd

		level 'Incurred Year Month Nbr'
			lineageTag: 970e0ca0-b479-4dc8-b218-72eb28ab1a9c
			column: 'Incurred Year Month Nbr'

	partition 'New M Partition' = m
		mode: dual
		source =
				let Source = Sql.Database(Servername, Lakehousename), dbo.incurred_month_eap = Source{[Schema="dbo",Item="incurred_month_eap"]}[Data]
				in
				dbo.incurred_month_eap

