table FACT_EAP_WBS_MBR_SMRY_PROD_SUBCLS
	lineageTag: 93a44462-5abb-4472-b268-4cb5b617d5d0

	measure 'EAP MemberMonthsBaseProdSubClsLevel' = SUM ( 'FACT_EAP_WBS_MBR_SMRY_PROD_SUBCLS'[PRORTD_MBR_MNTH_CNT] )
		lineageTag: 2e4d374b-e328-46a3-ade6-43f82eaeebb8

	measure 'EAP MemberMonthsProdSubClsLevel' =
			VAR _Sliding =
			    TRIM ( [Selected Sliding Window] )
			VAR min_date =
			    IF (
			        _Sliding = "YTD",
			        STARTOFYEAR ( 'Incurred Month'[Incurred Month Begin Dt] ),
			        IF (
			            _Sliding = "15",
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( _Sliding )
			            ),
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( [Selected Sliding Window] )
			            )
			        )
			    )
			VAR max_date =
			    IF (
			        _Sliding = "15",
			        EDATE ( MAX ( 'Incurred Month'[Incurred Month Begin Dt] ), -3 ),
			        MAX ( 'Incurred Month'[Incurred Month Begin Dt] )
			    )
			RETURN
			    CALCULATE (
			        [EAP MemberMonthsBaseProdSubClsLevel],
			        ALL ( 'Incurred Month' ),
			        DATESBETWEEN ( 'Incurred Month'[Incurred Month Begin Dt], min_date, max_date )
			    )
		lineageTag: e5eb0941-58b0-4cf4-95c5-6d60a0927bfe

