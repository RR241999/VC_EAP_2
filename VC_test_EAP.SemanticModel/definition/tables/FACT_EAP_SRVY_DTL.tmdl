	measure 'SuperScore ResponseInitial to FollowUp' = ```
			VAR _ini =
			    CALCULATE (
			        [Super ScoreAverage],
			        'FACT_EAP_SRVY_DTL'[Survey Type Name] = "Initial",
			        ALL ( 'FACT_EAP_SRVY_DTL'[Survey Type Name] ),
			        ALL ( FACT_EAP_SRVY_DTL[SRVY_TYPE_NM_SORT] )
			    )
			VAR _Foll =
			    CALCULATE (
			        [Super ScoreAverage],
			        'FACT_EAP_SRVY_DTL'[Survey Type Name] = "Follow-Up",
			        ALL ( 'FACT_EAP_SRVY_DTL'[Survey Type Name] ),
			        ALL ( FACT_EAP_SRVY_DTL[SRVY_TYPE_NM_SORT] )
			    )
			VAR _Total = ( _Foll - _ini )
			RETURN
			    DIVIDE ( _Total, _ini )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1b0eafe2-0d83-43b6-98c2-dc41a73cec74

