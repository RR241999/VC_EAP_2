	measure 'Estimated Productive HoursDFD Base' = ```
			VAR A =
			    SUMMARIZE (
			        FILTER (
			            FACT_EAP_SRVY_DTL,
			            FACT_EAP_SRVY_DTL[WOS_MATCH_IND] = 1
			            && 'FACT_EAP_SRVY_DTL'[Incident Number] = "UNK"
			        ),
			        'FACT_EAP_SRVY_DTL'[EAP Member Reference Number],
			        'FACT_EAP_SRVY_DTL'[Survey Type Name],
			        "TotalHours", CALCULATE(SUM ( 'DIM_EAP_SRVY_WOS'[Effective Number] ),'DIM_EAP_SRVY_WOS'[Title Name] = "Work Presenteeism")
			    )
			RETURN
			    CALCULATE ( SUMX ( a, [TotalHours] ))
			
			```
		lineageTag: a620951e-8291-483b-812d-e4f3c8617361

	measure 'Estimated Productive HoursDFD' = ```
			
			VAR _Sliding =
			    TRIM ( [Selected Sliding Window] )
			VAR min_date =
			    IF (
			        _Sliding = "YTD",
			        STARTOFYEAR ( 'Incurred Month'[Incurred Month Begin Dt] ),
			        IF (
			            _Sliding = "15",
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( _Sliding )
			            ),
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( [Selected Sliding Window] )
			            )
			        )
			    )
			VAR max_date =
			    IF (
			        _Sliding = "15",
			        EDATE ( MAX ( 'Incurred Month'[Incurred Month Begin Dt] ), -3 ),
			        MAX ( 'Incurred Month'[Incurred Month Begin Dt] ))
			RETURN
			    CALCULATE (
			        [Estimated Productive HoursDFD Base],
			        ALL ( 'Incurred Month' ),
			        DATESBETWEEN ( 'Incurred Month'[Incurred Month Begin Dt], min_date, max_date )
			    )
			
			```
		formatString: #,##0.00
		lineageTag: 941269f9-4383-47d7-93c4-407ec950e58b

