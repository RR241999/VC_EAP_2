	measure 'PHQ ResponseDFD %  Change' = ```
			VAR __Current = [PHQ ResponseDFD]
			VAR __PastPeriod = [PHQ ResponseDFD PY]
			RETURN
			    IF (
			        ISBLANK ( __Current ) && ISBLANK ( __PastPeriod ),
			        BLANK (),
			        IFERROR ( DIVIDE ( ( __Current - __PastPeriod ), __PastPeriod ), BLANK () )
			    )
			
