table FACT_EAP_SRVY_DTL
	lineageTag: bd26f9c5-209f-4031-93f1-be415701b997

	measure 'Total WOS SurveysReceived Base' = ```
			 VAR _IND =
			    FILTER (
			        FACT_EAP_SRVY_DTL,
			        FACT_EAP_SRVY_DTL[WOS_MATCH_IND] in { 1,0}
			            && 'FACT_EAP_SRVY_DTL'[Incident Number] <> "UNK"
			            && 'FACT_EAP_SRVY_DTL'[Survey Type Name] = "Follow-Up"
			            
			            )
			RETURN
			    CALCULATE (
			        DISTINCTCOUNT ( 'FACT_EAP_SRVY_DTL'[Incident Number] ),
			        _IND 
			    )
			
			```
		lineageTag: a5db8fc8-13e3-464d-809e-17220297fad2

	measure 'Total WOS SurveysReceived' = ```
			
			VAR _Sliding =
			    TRIM ( [Selected Sliding Window] )
			VAR min_date =
			    IF (
			        _Sliding = "YTD",
			        STARTOFYEAR ( 'Incurred Month'[Incurred Month Begin Dt] ),
			        IF (
			            _Sliding = "15",
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( _Sliding )
			            ),
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( [Selected Sliding Window] )
			            )
			        )
			    )
			VAR max_date =
			    IF (
			        _Sliding = "15",
			        EDATE ( MAX ( 'Incurred Month'[Incurred Month Begin Dt] ), -3 ),
			        MAX ( 'Incurred Month'[Incurred Month Begin Dt] ))
			RETURN
			    CALCULATE (
			        [Total WOS SurveysReceived Base],
			        ALL ( 'Incurred Month' ),
			        DATESBETWEEN ( 'Incurred Month'[Incurred Month Begin Dt], min_date, max_date )
			    )
			
			```
		formatString: #,0
		lineageTag: f3d2f2f3-2927-4ce4-9c55-310b51305309

	measure 'Total WOS SurveysReceived PY' = ```
			VAR __PP1 =
			    DATEADD ( 'Incurred Month'[Incurred Month Begin Dt], -1, YEAR )
			RETURN
			    CALCULATE ( [Total WOS SurveysReceived], ALL ( 'Incurred Month' ), __PP1 )
			
			```
		formatString: #,0
		lineageTag: 807ce4aa-c969-4d8c-a613-fdb2d24cca33

	measure 'Total WOS SurveysReceived %  Change' = ```
			VAR __Current = [Total WOS SurveysReceived]
			VAR __PastPeriod = [Total WOS SurveysReceived PY]
			RETURN
			    IF (
			        ISBLANK ( __Current ) && ISBLANK ( __PastPeriod ),
			        BLANK (),
			        IFERROR ( DIVIDE ( ( __Current - __PastPeriod ), __PastPeriod ), BLANK () )
			    )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6211093c-8edf-4090-83b7-30509a016a36

	measure 'Total WOS SurveysSent Base' = ```
