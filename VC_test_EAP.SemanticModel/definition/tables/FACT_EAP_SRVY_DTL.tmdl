	measure 'GAD Responses Initial to FollowUp' = ```
			VAR _ini =
			    CALCULATE (
			        [GAD Respondents],
			        'FACT_EAP_SRVY_DTL'[Survey Type Name] = "Initial",
			        ALL ( 'FACT_EAP_SRVY_DTL'[Survey Type Name] ),
			        ALL ( FACT_EAP_SRVY_DTL[SRVY_TYPE_NM_SORT] )
			    )
			VAR _Foll =
			    CALCULATE (
			        [GAD Respondents],
			        'FACT_EAP_SRVY_DTL'[Survey Type Name] = "Follow-Up",
			        ALL ( 'FACT_EAP_SRVY_DTL'[Survey Type Name] ),
			        ALL ( FACT_EAP_SRVY_DTL[SRVY_TYPE_NM_SORT] )
			    )
			VAR _Total = ( _Foll - _ini )
			RETURN
			    DIVIDE ( _Total, _ini )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0bd9ac7a-5143-43bd-bef1-2ef0cb6ce0f6

	measure 'PHQ Responses Initial to FollowUp' = ```
			VAR _ini =
			    CALCULATE (
			        [PHQ Respondents],
			        'FACT_EAP_SRVY_DTL'[Survey Type Name] = "Initial",
			        ALL ( 'FACT_EAP_SRVY_DTL'[Survey Type Name] ),
			        ALL ( FACT_EAP_SRVY_DTL[SRVY_TYPE_NM_SORT] )
			    )
			VAR _Foll =
			    CALCULATE (
			        [PHQ Respondents],
			        'FACT_EAP_SRVY_DTL'[Survey Type Name] = "Follow-Up",
			        ALL ( 'FACT_EAP_SRVY_DTL'[Survey Type Name] ),
			        ALL ( FACT_EAP_SRVY_DTL[SRVY_TYPE_NM_SORT] )
			    )
			VAR _Total = ( _ini- _Foll )
			RETURN
			    DIVIDE ( _Total, _Foll )
			
			```
