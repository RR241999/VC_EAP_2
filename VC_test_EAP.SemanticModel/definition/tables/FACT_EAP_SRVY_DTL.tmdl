	column 'PRE EAP Survey Problem Total' =
			VAR MemberId = 'FACT_EAP_SRVY_DTL'[Incident Number]
			VAR MonthNbr = 'FACT_EAP_SRVY_DTL'[RPTG_MNTH_NBR]
			
			VAR DistinctTTLPrblm =
			    DISTINCT (
			        SELECTCOLUMNS (
			            FILTER (
			                ALL ( 'FACT_EAP_SRVY_DTL' ),
			                'FACT_EAP_SRVY_DTL'[Incident Number] = MemberId
			                    && 'FACT_EAP_SRVY_DTL'[RPTG_MNTH_NBR] = MonthNbr
			                    && 'FACT_EAP_SRVY_DTL'[WOS_MATCH_IND] = 2
			                    && 'FACT_EAP_SRVY_DTL'[Survey Type Name] = "Initial"
			                    && 'FACT_EAP_SRVY_DTL'[TTL_NM]
			                        IN {
			                            "Workplace Distress",
			                            "Work Presenteeism",
			                            "Work Absenteeism",
			                            "Work Engagement"
			                        }
			            ),
			            "TTL_NM",    'FACT_EAP_SRVY_DTL'[TTL_NM],
			            "PRBLM_NBR", 'FACT_EAP_SRVY_DTL'[PRBLM_NBR]
			        )
			    )
			RETURN
			    SUMX ( DistinctTTLPrblm, [PRBLM_NBR] )
		dataType: int64
		formatString: #,##0
		lineageTag: fe1e204e-0804-42c1-bb9f-3763ea47c14b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'PRE EAP Survey Problem TotalDFD' =
			VAR MemberId = 'FACT_EAP_SRVY_DTL'[EAP Member Reference Number]
			VAR MonthNbr = 'FACT_EAP_SRVY_DTL'[RPTG_MNTH_NBR]
			
			VAR DistinctTTLPrblm =
			    DISTINCT (
			        SELECTCOLUMNS (
			            FILTER (
			                ALL ( 'FACT_EAP_SRVY_DTL' ),
			                'FACT_EAP_SRVY_DTL'[EAP Member Reference Number] = MemberId
			                    && 'FACT_EAP_SRVY_DTL'[RPTG_MNTH_NBR] = MonthNbr
			                    && 'FACT_EAP_SRVY_DTL'[WOS_MATCH_IND] = 2
			                    && 'FACT_EAP_SRVY_DTL'[Survey Type Name] = "Initial"
			                    && 'FACT_EAP_SRVY_DTL'[TTL_NM]
			                        IN {
			                            "Workplace Distress",
			                            "Work Presenteeism",
			                            "Work Absenteeism",
			                            "Work Engagement"
			                        }
			            ),
			            "TTL_NM",    'FACT_EAP_SRVY_DTL'[TTL_NM],
			            "PRBLM_NBR", 'FACT_EAP_SRVY_DTL'[PRBLM_NBR]
			        )
			    )
			RETURN
			    SUMX ( DistinctTTLPrblm, [PRBLM_NBR] )
		dataType: int64
		formatString: #,##0
		lineageTag: 7c045fe0-2441-49f6-8448-c6a86b08e97a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

