	measure 'SuperScore ResponseDFD Base' = ```
			VAR A =
			    SUMMARIZE (
			        FILTER (
			            FACT_EAP_SRVY_DTL,
			            FACT_EAP_SRVY_DTL[WOS_MATCH_IND] = 11
			            && 'FACT_EAP_SRVY_DTL'[Incident Number] = "UNK"
			        ),
			        'FACT_EAP_SRVY_DTL'[EAP Member Reference Number],
			        'FACT_EAP_SRVY_DTL'[Survey Type Name],
			        "Valmember", calculate(SUM ( 'DIM_EAP_SRVY_WOS'[Value Number] ),keepfilters('DIM_EAP_SRVY_WOS'[Supervisor Score Code] = "YES" ))
			    )
			RETURN
			    CALCULATE ( SUMX ( a, [Valmember] ), 'DIM_EAP_SRVY_WOS'[Supervisor Score Code] = "YES")
			
			```
		lineageTag: fedaa50a-2f67-4556-a819-355beaa012f5

	measure 'SuperScore ResponseDFD' = ```
			
			VAR _Sliding =
			    TRIM ( [Selected Sliding Window] )
			VAR min_date =
			    IF (
			        _Sliding = "YTD",
			        STARTOFYEAR ( 'Incurred Month'[Incurred Month Begin Dt] ),
			        IF (
			            _Sliding = "15",
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( _Sliding )
			            ),
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( [Selected Sliding Window] )
			            )
			        )
			    )
			VAR max_date =
			    IF (
			        _Sliding = "15",
			        EDATE ( MAX ( 'Incurred Month'[Incurred Month Begin Dt] ), -3 ),
			        MAX ( 'Incurred Month'[Incurred Month Begin Dt] ))
			RETURN
			    CALCULATE (
			        [SuperScore ResponseDFD Base],
			        ALL ( 'Incurred Month' ),
			        DATESBETWEEN ( 'Incurred Month'[Incurred Month Begin Dt], min_date, max_date )
			    )
			
			```
		formatString: #,0
		lineageTag: 885a4962-4f66-48c6-861d-76bd0ae3779d

	measure 'SuperScore ResponseDFD PY' = ```
