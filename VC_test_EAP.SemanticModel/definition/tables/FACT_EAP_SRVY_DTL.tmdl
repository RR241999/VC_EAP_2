	measure 'PHQ9 ResponseDFD Base' = ```
			VAR A =
			    SUMMARIZE (
			        FILTER (
			            FACT_EAP_SRVY_DTL,
			            FACT_EAP_SRVY_DTL[PHQ9_MATCH_IND] = 99
			            && 'FACT_EAP_SRVY_DTL'[Incident Number] ="UNK"
			        ),
			        'FACT_EAP_SRVY_DTL'[EAP Member Reference Number],
			        'FACT_EAP_SRVY_DTL'[Patient Health Questionnaire (PHQ) Type Code],
			        "Valmember", SUM ( 'DIM_EAP_SRVY_PHQ'[Value Score Number] )
			    )
			RETURN
			    CALCULATE ( SUMX ( a, [Valmember] ) )
			
			```
		lineageTag: 7c95005f-eeba-4020-8fce-3a319cb44eb8

	measure 'PHQ9 ResponseDFD' = ```
			
