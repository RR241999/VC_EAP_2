	measure 'Events PY' =
			VAR __PP1 =
			    DATEADD ( 'Incurred Month'[Incurred Month Begin Dt], -1, YEAR )
			RETURN
			    CALCULATE ( [Events], ALL ( 'Incurred Month' ), __PP1 )
		formatString: #,0
		lineageTag: d4fae347-61f6-4fdf-a12c-22ab03e20a40

	measure 'Events %  Change' =
			VAR __Current = [Events]
			VAR __PastPeriod = [Events PY]
			RETURN
			    IF (
			        ISBLANK ( __Current ) && ISBLANK ( __PastPeriod ),
			        BLANK (),
			        IFERROR ( DIVIDE ( ( __Current - __PastPeriod ), __PastPeriod ), BLANK () )
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 823936ce-78c1-4e9e-a1fe-b8d1e560f3b6

