	measure Events =
			
			VAR _Sliding =
			    TRIM ( [Selected Sliding Window] )
			VAR min_date =
			    IF (
			        _Sliding = "YTD",
			        STARTOFYEAR ( 'Incurred Month'[Incurred Month Begin Dt] ),
			        IF (
			            _Sliding = "15",
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( _Sliding )
			            ),
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( [Selected Sliding Window] )
			            )
			        )
			    )
			VAR max_date =
			    IF (
			        _Sliding = "15",
			        EDATE ( MAX ( 'Incurred Month'[Incurred Month Begin Dt] ), -3 ),
			        MAX ( 'Incurred Month'[Incurred Month Begin Dt] ))
			RETURN
			    CALCULATE (
			        [Events Base],FILTER(
			            KEEPFILTERS(VALUES('DIM_EAP_EVNT_SRVC_TYPE'[EAP Management Service Group Description])),
			            NOT('DIM_EAP_EVNT_SRVC_TYPE'[EAP Management Service Group Description] IN {"Travel"})
			        ),
			        ALL ( 'Incurred Month' ),
			        DATESBETWEEN ( 'Incurred Month'[Incurred Month Begin Dt], min_date, max_date )
			    )
		formatString: #,0
		lineageTag: 75032525-1fd1-44a3-b24b-c16445f52969

