table FACT_EAP_WORK_MBR_MDCL_PROD_DTL
	lineageTag: a582af9e-70aa-41a2-b312-21bcb94ad397

	measure 'EAP MemberMonthsBaseMLevel' = SUM ( 'FACT_EAP_WORK_MBR_MDCL_PROD_DTL'[PRORTD_MBR_MNTH_CNT] )
		lineageTag: 91c69680-fc40-41c5-a6f7-a7a3db9678ef

	measure 'EAP MemberMonthsMLevel' =
			VAR _Sliding =
			    TRIM ( [Selected Sliding Window] )
			VAR min_date =
			    IF (
			        _Sliding = "YTD",
			        STARTOFYEAR ( 'Incurred Month'[Incurred Month Begin Dt] ),
			        IF (
			            _Sliding = "15",
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( _Sliding )
			            ),
			            EDATE (
			                MIN ( 'Incurred Month'[Incurred Month Begin Dt] ),
			                1 - VALUE ( [Selected Sliding Window] )
			            )
			        )
			    )
			VAR max_date =
			    IF (
			        _Sliding = "15",
			        EDATE ( MAX ( 'Incurred Month'[Incurred Month Begin Dt] ), -3 ),
			        MAX ( 'Incurred Month'[Incurred Month Begin Dt] )
			    )
			RETURN
			    CALCULATE (
			        [EAP MemberMonthsBaseMLevel],
			        ALL ( 'Incurred Month' ),
			        DATESBETWEEN ( 'Incurred Month'[Incurred Month Begin Dt], min_date, max_date )
			    )
		lineageTag: 7db46708-be49-45cd-8db4-c47bc84e0858

